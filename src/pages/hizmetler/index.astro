---
import Layout from '../../layouts/Layout.astro';import Icon from '../../components/Icon.astro';import BottomCta from '../../components/BottomCta.astro';import {services} from '../../data/site';
const schema=[{'@type':'ItemList',name:'Alifa Çilingir Hizmetleri',itemListElement:services.map((s,i)=>({'@type':'ListItem',position:i+1,name:s.title,url:new URL('/hizmetler/'+s.slug+'/',Astro.site).href}))}];
---
<Layout title="Çilingir Hizmetleri | Kapı, Araç ve Kasa · Alifa Çilingir" description="Kapı açma, oto çilingir, kasa açma, kilit değişimi, kırık anahtar çıkarma ve çelik kapı kilit tamiri. Hizmet detaylarını Alifa Çilingir ile öğrenin." crumbs={[{name:'Hizmetler',url:'/hizmetler/'}]} schema={schema}><div class="container"><header class="page-intro"><div class="eyebrow">HİZMETLERİMİZ</div><h1>Kilit sorununuz için<br/>doğru hizmet.</h1><p>Evinizin kapısından aracınızın kilidine kadar, ihtiyacınıza uygun çözümü birlikte belirleyelim. Hizmet detaylarını inceleyin, bizi arayın.</p></header><div class="index-grid">{services.map(s=><a class="service-card" href={'/hizmetler/'+s.slug+'/'}><div class="service-top"><span class="service-icon"><Icon name={s.icon} size={25}/></span><Icon name="arrow" size={20}/></div><h3>{s.title}</h3><p>{s.summary}</p></a>)}</div></div><BottomCta/></Layout>
